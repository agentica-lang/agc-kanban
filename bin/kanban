#!/bin/sh
set -eu
# Follow the symlink that `make install-cli` creates, then find the repo.
self=$0
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=$(dirname -- "$self")/$target ;;
  esac
done
root=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)
# KANBAN_TEST_PROGRAM is for the specs only: they run a program compiled to a
# temporary file.
program=${KANBAN_TEST_PROGRAM:-$root/dist/kanban.agcb}

# Agentica cannot see a closed standard output: the write ends the program
# with RUNTIME-INTERNAL "cannot write to standard output" (exit 1), whatever
# the cause. When standard output is a pipe and that is the VM's own line,
# the reader left early (`kanban board show | head -1`): exit 141, silently,
# as a Unix tool killed by SIGPIPE. Any other failure (a full disk, a
# closed descriptor) keeps its message.
# See https://github.com/agentica-lang/agentica/issues/1455.
# The price: stderr is shown at the end, not live, and is never a terminal.
errors=$(mktemp 2>/dev/null) || exec agentica run -- "$program" "$@"

# The child runs in the background so a signal reaches this shell at once.
# Without these traps (dash runs no EXIT trap on a signal) a TERM would leave
# `agentica` running and the temp file behind.
pid=
cleanup() { rm -f "$errors"; }
trap cleanup EXIT
trap '[ -z "$pid" ] || kill "$pid" 2>/dev/null; exit 143' TERM HUP
trap '[ -z "$pid" ] || kill -INT "$pid" 2>/dev/null; exit 130' INT

# `<&0` is explicit because a background job of a non-interactive shell
# otherwise reads /dev/null, and `card comment ID -` reads standard input.
agentica run -- "$program" "$@" <&0 2>"$errors" &
pid=$!
status=0
wait "$pid" || status=$?
pid=

if [ "$status" -ne 0 ] && [ -p /dev/stdout ] && grep -qx 'cannot write to standard output' "$errors"; then
  exit 141
fi
cat "$errors" >&2 || :
exit "$status"
