#!/bin/sh
set -eu
# Follow the symlink that `make install-cli` creates, then find the repo.
self=$0
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=$(dirname -- "$self")/$target ;;
  esac
done
root=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)
program=${KANBAN_PROGRAM:-$root/dist/kanban.agcb}

# Agentica has no way to see a closed standard output: the write ends the
# program with RUNTIME-INTERNAL "cannot write to standard output" (exit 1).
# Exit quietly with 141, as a Unix tool killed by SIGPIPE, so
# `kanban board show | head -1` prints nothing more.
# See https://github.com/agentica-lang/agentica/issues/1455.
errors=$(mktemp)
trap 'rm -f "$errors"' EXIT
status=0
agentica run -- "$program" "$@" 2>"$errors" || status=$?
if [ "$status" -ne 0 ] && grep -qF 'cannot write to standard output' "$errors"; then
  exit 141
fi
cat "$errors" >&2
exit "$status"
